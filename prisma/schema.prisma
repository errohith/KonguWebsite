// Kongu Matrimony — PostgreSQL schema.
// Design notes: docs/DATABASE_DESIGN.md
//
// Conventions
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
// - All timestamps are `timestamptz` and stored in UTC.
// - Money is `numeric(12,2)` in the plan's currency (INR by default).
// - Lifecycle states are explicit enums; never infer state from nullable columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication
// ---------------------------------------------------------------------------

enum UserRole {
  MEMBER
  SUPPORT
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETION_REQUESTED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum Locale {
  en
  ta
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique
  phone               String?    @unique
  passwordHash        String
  role                UserRole   @default(MEMBER)
  status              UserStatus @default(PENDING_VERIFICATION)
  /// Captured at registration for the adult-eligibility check.
  dateOfBirth         DateTime   @db.Date
  gender              Gender
  locale              Locale     @default(en)
  emailVerifiedAt     DateTime?  @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?  @db.Timestamptz(6)
  termsAcceptedAt     DateTime   @db.Timestamptz(6)
  lastLoginAt         DateTime?  @db.Timestamptz(6)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(6)
  deactivatedAt       DateTime?  @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @db.Timestamptz(6)
  deletionScheduledAt DateTime?  @db.Timestamptz(6)
  deletedAt           DateTime?  @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)

  sessions           Session[]
  verificationTokens VerificationToken[]
  profile            Profile?
  subscriptions      Subscription[]
  payments           Payment[]
  shortlists         Shortlist[]
  blocksMade         Block[]                @relation("BlocksMade")
  blocksReceived     Block[]                @relation("BlocksReceived")
  reportsMade        Report[]               @relation("ReportsMade")
  reportsHandled     Report[]               @relation("ReportsHandled")
  verificationReview VerificationRequest[]  @relation("VerificationReviewer")
  contactViews       ContactView[]
  notifications      Notification[]
  supportTickets     SupportTicket[]        @relation("TicketRequester")
  ticketsAssigned    SupportTicket[]        @relation("TicketAssignee")
  ticketMessages     SupportTicketMessage[]
  auditLogs          AuditLog[]
  contentEdits       SiteContent[]
  refundsRecorded    Refund[]

  @@index([status])
  @@index([role])
  @@index([deletionScheduledAt])
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash  String   @unique
  userId     String   @db.Uuid
  expiresAt  DateTime @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(6)
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP
}

model VerificationToken {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                @db.Uuid
  type       VerificationTokenType
  /// HMAC-SHA256 of the token/OTP keyed with AUTH_SECRET.
  tokenHash  String                @unique
  expiresAt  DateTime              @db.Timestamptz(6)
  consumedAt DateTime?             @db.Timestamptz(6)
  attempts   Int                   @default(0)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

enum ProfileCreatedFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum EmploymentType {
  PRIVATE
  GOVERNMENT
  BUSINESS
  SELF_EMPLOYED
  NOT_WORKING
  OTHER
}

enum EducationLevel {
  SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  DOCTORATE
  PROFESSIONAL
  OTHER
}

enum ResidencyStatus {
  CITIZEN
  NRI
  PERMANENT_RESIDENT
  WORK_PERMIT
  STUDENT_VISA
  OTHER
}

enum FamilyType {
  NUCLEAR
  JOINT
  OTHER
}

enum FamilyStatus {
  MIDDLE_CLASS
  UPPER_MIDDLE_CLASS
  AFFLUENT
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  HIDDEN
  SUSPENDED
}

enum ProfileVisibility {
  /// Visible to all signed-in members with a published profile.
  MEMBERS
  /// Visible only to members with an active premium plan.
  PREMIUM_MEMBERS
  /// Not shown in search; only members the owner has an accepted interest with.
  HIDDEN
}

enum PhotoVisibility {
  MEMBERS
  ACCEPTED_INTERESTS
  HIDDEN
}

enum VerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Profile {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Sequential number; the public ID shown to members is "KM" + profileNumber.
  profileNumber      Int               @unique @default(autoincrement())
  userId             String            @unique @db.Uuid
  createdFor         ProfileCreatedFor @default(SELF)
  displayName        String
  gender             Gender
  dateOfBirth        DateTime          @db.Date
  maritalStatus      MaritalStatus     @default(NEVER_MARRIED)
  heightCm           Int?
  motherTongue       String?           @default("Tamil")
  religion           String?           @default("Hindu")
  community          String?           @default("Kongu Vellalar Gounder")
  /// Kongu clan (kootam). Matching within the same kootam is traditionally avoided.
  kootam             String?
  aboutMe            String?

  highestEducation   EducationLevel?
  educationDetail    String?
  occupation         String?
  employmentType     EmploymentType?
  annualIncomeInr    Decimal?          @db.Decimal(12, 2)

  nativePlace        String?
  nativeDistrict     String?
  currentCity        String?
  currentState       String?
  /// ISO 3166-1 alpha-2 country code.
  currentCountry     String?           @default("IN") @db.Char(2)
  residencyStatus    ResidencyStatus?

  fatherOccupation   String?
  motherOccupation   String?
  siblingsSummary    String?
  familyType         FamilyType?
  familyStatus       FamilyStatus?
  familyDetails      String?

  visibility         ProfileVisibility @default(MEMBERS)
  photoVisibility    PhotoVisibility   @default(MEMBERS)
  status             ProfileStatus     @default(DRAFT)
  verificationState  VerificationState @default(UNVERIFIED)
  moderationNote     String?
  completeness       Int               @default(0)
  publishedAt        DateTime?         @db.Timestamptz(6)
  lastActiveAt       DateTime          @default(now()) @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact              ProfileContact?
  horoscope            Horoscope?
  preference           PartnerPreference?
  photos               Photo[]
  documents            Document[]
  verificationRequests VerificationRequest[]
  interestsSent        Interest[]            @relation("InterestSender")
  interestsReceived    Interest[]            @relation("InterestReceiver")
  shortlistedBy        Shortlist[]
  reports              Report[]
  contactViews         ContactView[]

  @@index([status, gender, dateOfBirth])
  @@index([currentCountry, currentState, currentCity])
  @@index([highestEducation])
  @@index([employmentType])
  @@index([maritalStatus])
  @@index([kootam])
  @@index([lastActiveAt])
  @@index([status, verificationState])
}

/// Contact details are split from Profile so they are never selected by accident.
model ProfileContact {
  profileId    String   @id @db.Uuid
  contactName  String?
  contactPhone String?
  contactEmail String?
  relationship String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Horoscope {
  profileId   String   @id @db.Uuid
  rasi        String?
  nakshatram  String?
  lagnam      String?
  /// e.g. "None", "Chevvai dosham" — free text, user supplied.
  dosham      String?
  /// Local time of birth, "HH:MM".
  birthTime   String?
  birthPlace  String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PartnerPreference {
  profileId         String          @id @db.Uuid
  ageMin            Int?
  ageMax            Int?
  heightMinCm       Int?
  heightMaxCm       Int?
  maritalStatuses   MaritalStatus[]
  educationLevels   EducationLevel[]
  employmentTypes   EmploymentType[]
  countries         String[]
  states            String[]
  excludeSameKootam Boolean         @default(true)
  aboutPartner      String?
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Media & documents
// ---------------------------------------------------------------------------

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Photo {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String           @db.Uuid
  storageKey       String           @unique
  mimeType         String
  sizeBytes        Int
  isPrimary        Boolean          @default(false)
  sortOrder        Int              @default(0)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
  @@index([moderationStatus])
}

enum DocumentType {
  ID_PROOF
  HOROSCOPE
  EDUCATION
  OTHER
}

model Document {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String       @db.Uuid
  type       DocumentType
  storageKey String       @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  profile              Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  verificationRequests VerificationRequest[]

  @@index([profileId])
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model VerificationRequest {
  id         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String                    @db.Uuid
  documentId String?                   @db.Uuid
  status     VerificationRequestStatus @default(PENDING)
  note       String?
  reviewerId String?                   @db.Uuid
  reviewNote String?
  reviewedAt DateTime?                 @db.Timestamptz(6)
  createdAt  DateTime                  @default(now()) @db.Timestamptz(6)

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewer User?     @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Discovery & relationships
// ---------------------------------------------------------------------------

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Interest {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderProfileId   String         @db.Uuid
  receiverProfileId String         @db.Uuid
  status            InterestStatus @default(PENDING)
  message           String?
  respondedAt       DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)

  sender   Profile @relation("InterestSender", fields: [senderProfileId], references: [id], onDelete: Cascade)
  receiver Profile @relation("InterestReceiver", fields: [receiverProfileId], references: [id], onDelete: Cascade)

  /// Prevents duplicate interests in the same direction; the reverse direction
  /// is checked in the service layer.
  @@unique([senderProfileId, receiverProfileId])
  @@index([receiverProfileId, status])
  @@index([senderProfileId, createdAt])
}

model Shortlist {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  targetProfileId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetProfile Profile @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, targetProfileId])
}

model Block {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerUserId String   @db.Uuid
  blockedUserId String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  blocker User @relation("BlocksMade", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  HARASSMENT
  SCAM_OR_FRAUD
  ALREADY_MARRIED
  UNDERAGE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterUserId    String       @db.Uuid
  reportedProfileId String       @db.Uuid
  reason            ReportReason
  details           String?
  status            ReportStatus @default(OPEN)
  handledById       String?      @db.Uuid
  resolutionNote    String?
  resolvedAt        DateTime?    @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)

  reporter        User    @relation("ReportsMade", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedProfile Profile @relation(fields: [reportedProfileId], references: [id], onDelete: Cascade)
  handledBy       User?   @relation("ReportsHandled", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedProfileId])
}

/// Records each unlocked contact so quotas are counted once per target.
model ContactView {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  viewerUserId    String   @db.Uuid
  targetProfileId String   @db.Uuid
  subscriptionId  String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  viewer        User          @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)
  targetProfile Profile       @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([viewerUserId, targetProfileId])
  @@index([subscriptionId])
}

// ---------------------------------------------------------------------------
// Membership & payments
// ---------------------------------------------------------------------------

model MembershipPlan {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable machine code, e.g. FREE, GOLD_3M. "FREE" is the default entitlement set.
  code                 String   @unique
  name                 String
  nameTa               String?
  description          String?
  descriptionTa        String?
  price                Decimal  @db.Decimal(12, 2)
  currency             String   @default("INR") @db.Char(3)
  durationDays         Int
  interestsPerDay      Int
  contactViewsIncluded Int      @default(0)
  canViewContacts      Boolean  @default(false)
  canViewPremiumOnly   Boolean  @default(false)
  highlightProfile     Boolean  @default(false)
  /// Marketing bullet points (display only; enforcement uses the typed columns).
  benefits             String[]
  benefitsTa           String[]
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
  payments      Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @db.Uuid
  planId           String             @db.Uuid
  /// One subscription per captured payment — guards double activation.
  paymentId        String?            @unique @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startsAt         DateTime           @db.Timestamptz(6)
  endsAt           DateTime           @db.Timestamptz(6)
  cancelledAt      DateTime?          @db.Timestamptz(6)
  cancelReason     String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment      Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  contactViews ContactView[]

  @@index([userId, status, endsAt])
  @@index([status, endsAt])
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @db.Uuid
  planId            String        @db.Uuid
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  amountRefunded    Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  capturedAt        DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan         MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?
  refunds      Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String       @db.Uuid
  providerRefundId String?      @unique
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  reason           String?
  recordedById     String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Idempotency ledger for payment webhooks: (provider, eventId) is unique.
model WebhookEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime           @default(now()) @db.Timestamptz(6)
  processedAt DateTime?          @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

// ---------------------------------------------------------------------------
// Notifications, support, content, audit
// ---------------------------------------------------------------------------

enum NotificationType {
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  PROFILE_APPROVED
  PROFILE_REJECTED
  PHOTO_REJECTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING
  SUPPORT_REPLY
  SYSTEM
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ACCOUNT
  PROFILE
  PAYMENT
  SAFETY
  OTHER
}

model SupportTicket {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId  String?        @db.Uuid
  name         String
  email        String
  subject      String
  category     TicketCategory @default(OTHER)
  status       TicketStatus   @default(OPEN)
  assignedToId String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  requester  User?                  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignedTo User?                  @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([requesterId])
}

model SupportTicketMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String?  @db.Uuid
  isStaff   Boolean  @default(false)
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// Administrator-editable website content blocks (per locale).
model SiteContent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  locale      Locale
  title       String?
  body        String
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, locale])
}

model Faq {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locale      Locale
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([locale, isPublished, sortOrder])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

/// Fixed-window rate limit counters (used when REDIS_URL is not configured).
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(6)
  count       Int
}
