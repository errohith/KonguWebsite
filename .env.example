# =============================================================================
# Kongu Matrimony — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` for local development (`cp .env.example .env`) and fill in
# values. NEVER commit `.env` or any file containing real credentials.
# Full reference: docs/ENVIRONMENT_VARIABLES.md
#
# Variables prefixed with NEXT_PUBLIC_ are bundled into browser JavaScript.
# Never put secrets behind that prefix.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
# development | staging | production — selects safety rules (e.g. console
# providers are refused outside development).
APP_ENV=development
APP_NAME=Kongu Matrimony
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kongu Matrimony
# Support address shown on the contact page.
SUPPORT_EMAIL=support@example.invalid

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/matrimonial_kongu?schema=public
# Max connections in the app's pg pool (per process).
DATABASE_POOL_MAX=10

# --- Authentication & sessions -----------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_COOKIE_NAME=km_session
SESSION_TTL_DAYS=30
# true in staging/production (requires HTTPS). Defaults to true when APP_URL is https.
SESSION_COOKIE_SECURE=false
# Minimum age to register (India: 21 for men, 18 for women under PCMA 2006).
MIN_AGE_MALE=21
MIN_AGE_FEMALE=18

# --- CORS / origin checks ----------------------------------------------------
# Comma-separated origins allowed to call mutating API endpoints.
CORS_ORIGINS=http://localhost:3000

# --- File storage ------------------------------------------------------------
# local | s3 (s3 adapter not yet implemented — see docs/PROJECT_STATUS.md)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_BYTES=5242880
MAX_PHOTOS_PER_PROFILE=6

# --- Email -------------------------------------------------------------------
# disabled | console (development only — prints to server log) | resend
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=Kongu Matrimony <no-reply@example.invalid>

# --- SMS / OTP ---------------------------------------------------------------
# disabled | console (development only)
SMS_PROVIDER=disabled
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments ----------------------------------------------------------------
# disabled | razorpay
PAYMENT_PROVIDER=disabled
PAYMENT_API_BASE_URL=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Browser checkout script URL from your provider's documentation.
PAYMENT_CHECKOUT_SCRIPT_URL=

# --- Logging & monitoring ----------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# none | console
ERROR_TRACKING_PROVIDER=none
ERROR_TRACKING_DSN=

# --- Optional integrations ---------------------------------------------------
REDIS_URL=
CDN_BASE_URL=
# If set, server-side analytics events are POSTed here as JSON.
ANALYTICS_ENDPOINT=

# --- Feature flags -----------------------------------------------------------
ENABLE_EMAIL_VERIFICATION=true
ENABLE_SMS_VERIFICATION=false
ENABLE_PAYMENTS=false
ENABLE_HOROSCOPE_FEATURE=false
ENABLE_PROFILE_VERIFICATION=true
# Require moderator approval before a profile becomes visible in search.
ENABLE_PROFILE_MODERATION=true

# --- Account lifecycle -------------------------------------------------------
# Days between a deletion request and permanent anonymisation.
ACCOUNT_DELETION_GRACE_DAYS=14

# --- Development seed (never used in production) -----------------------------
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_DEV_PASSWORD
